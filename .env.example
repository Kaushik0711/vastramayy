# Vastramay Environment Configuration Template
# Duplicate this file to .env.local for local overrides.
# NOTE: Never commit production API keys or secrets to version control.

# Application Identity & Mode
VITE_APP_NAME="Vastramay Couture"
VITE_APP_URL="http://localhost:3000"
VITE_ENVIRONMENT="development"

# Storage & Backend Configuration
# When VITE_USE_MOCK_STORAGE is true, the app runs offline using VersionedLocalStorageAdapter
VITE_USE_MOCK_STORAGE=true
VITE_STORAGE_PREFIX="vastramay"

# Optional Cloud API URL (for future Phase 13+ backend connection)
# VITE_API_BASE_URL="https://api.vastramay.com/v1"
